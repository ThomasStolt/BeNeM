# BeNeM lab credentials — TEMPLATE. Copy to `.env` and fill it in there.
#
#   cp .env.example .env
#
# `.env` is gitignored (`*.env`); THIS file is tracked, so never put a real
# value in it. The credential guard (middleware/tests/test_no_credentials_in_repo.py)
# scans tracked files and will fail the suite if you do.
#
# NOTE: a trailing `# comment` on a value line becomes PART OF THE VALUE in a
# .env file. Every comment here is on its own line for that reason.

# ─── BHNM-A — HA deployment, SE GROUP of two ────────────────────────────────
# Primary, 192.168.2.208 (VMID 208).
# No VIP, so this address does NOT follow a failover to the replica.
BHNM_A_URL=https://bhnm-a-m.local
# Replica, 192.168.2.210 (VMID 210).
BHNM_A_REPLICA_URL=https://bhnm-a-r.local
# Arbitrator, 192.168.2.209 (VMID 209).
BHNM_A_ARBITRATOR_HOST=bhnm-a-a.local
BHNM_A_API_KEY=
BHNM_A_UI_USER=
BHNM_A_UI_PASSWORD=
# SaaS only — leave empty on-prem.
BHNM_A_PIN=

# The SE group. EXPERIMENT 2 runs here.
BHNM_A_SE_GROUP_MEMBERS=BHNM-A-SE01,BHNM-A-SE02
# The SE that gets stopped.
BHNM_A_SE_STOP_TARGET=BHNM-A-SE01
# Comma-separated, EXACTLY as BHNM spells them. Not readable from the API.
BHNM_A_SE_MANAGED_DEVICES=

# ─── BHNM-B — single instance, ONE Service Engine ───────────────────────────
# 192.168.2.211 (VMID 211). This is the instance BeNeM's middleware already
# points at, as "Thomas' Lab Server".
BHNM_B_URL=https://bhnm-b.tstolt.com
BHNM_B_API_KEY=
BHNM_B_UI_USER=
BHNM_B_UI_PASSWORD=
BHNM_B_PIN=

# The standalone SE, 192.168.2.214 (VMID 214). EXPERIMENT 1 runs here.
BHNM_B_SE=BHNM-B-SE01
# Comma-separated, EXACTLY as BHNM spells them.
BHNM_B_SE_MANAGED_DEVICES=

# ─── Proxmox ────────────────────────────────────────────────────────────────
# Already key-based over ssh (192.168.2.194, root, ~/.ssh/claryon_cluster).
# Recorded so a stop can be timestamped exactly rather than reported by hand.
PVE_SSH_HOST=pve-jump
PVE_NODE=pve
PVE_VMID_BHNM_A_PRIMARY=208
PVE_VMID_BHNM_A_ARBITRATOR=209
PVE_VMID_BHNM_A_REPLICA=210
PVE_VMID_BHNM_B=211
PVE_VMID_BHNM_A_SE01=212
PVE_VMID_BHNM_A_SE02=213
PVE_VMID_BHNM_B_SE01=214

# ─── BeNeM middleware ───────────────────────────────────────────────────────
# ssh is key-based; the per-server api_keys live in /data/servers.json ON THE
# VPS and are deliberately NOT duplicated here.
MIDDLEWARE_SSH=root@bhnm-apns.hurrikap.org
MIDDLEWARE_HEALTH_URL=https://bhnm-apns.hurrikap.org/health
